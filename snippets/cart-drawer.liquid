{%- comment -%}
  Cart drawer snippet — slides in from the right
  Usage: {% render 'cart-drawer' %}
{%- endcomment -%}

<div id="cart-drawer" class="fixed inset-0 z-50 pointer-events-none" aria-hidden="true">
  {%- comment -%} Overlay {%- endcomment -%}
  <div id="cart-drawer-overlay" class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300 pointer-events-none"></div>

  {%- comment -%} Drawer {%- endcomment -%}
  <div id="cart-drawer-panel" class="absolute top-0 right-0 bottom-0 w-full max-w-md bg-black border-l border-[#222] translate-x-full transition-transform duration-300 pointer-events-auto flex flex-col">

    {%- comment -%} Header {%- endcomment -%}
    <div class="flex items-center justify-between px-6 h-20 border-b border-[#222] flex-shrink-0">
      <h2 class="text-xs font-bold uppercase tracking-[0.2em]">Your Cart (<span id="cart-drawer-count">{{ cart.item_count }}</span>)</h2>
      <button id="cart-drawer-close" class="text-xs uppercase tracking-widest hover:text-gray-400 transition-colors" aria-label="Close cart">
        Close
      </button>
    </div>

    {%- comment -%} Items {%- endcomment -%}
    <div id="cart-drawer-items" class="flex-1 overflow-y-auto px-6 py-6">
      {%- if cart.item_count > 0 -%}
        {%- for item in cart.items -%}
          <div class="flex gap-4 pb-6 mb-6 border-b border-[#222]" data-cart-item="{{ item.key }}">
            <a href="{{ item.url }}" class="w-20 flex-shrink-0 aspect-[3/4] bg-[#111] overflow-hidden border border-[#222]">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover" loading="lazy">
              {%- endif -%}
            </a>
            <div class="flex-1 flex flex-col justify-between min-w-0">
              <div>
                <a href="{{ item.url }}" class="text-xs font-bold uppercase tracking-widest block truncate hover:text-gray-400 transition-colors">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="text-[10px] text-gray-500 uppercase tracking-widest mt-1">{{ item.variant.title }}</p>
                {%- endunless -%}
              </div>
              <div class="flex items-center justify-between mt-2">
                <div class="flex items-center border border-[#222]">
                  <button class="cart-qty-btn px-2 py-1 text-xs hover:text-gray-400 transition-colors" data-action="decrease" data-key="{{ item.key }}">−</button>
                  <span class="px-2 py-1 text-xs font-mono min-w-[2rem] text-center">{{ item.quantity }}</span>
                  <button class="cart-qty-btn px-2 py-1 text-xs hover:text-gray-400 transition-colors" data-action="increase" data-key="{{ item.key }}">+</button>
                </div>
                <span class="text-xs">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="flex flex-col items-center justify-center h-full text-center">
          <p class="text-sm text-gray-500 uppercase tracking-widest mb-6">Your cart is empty</p>
          <a href="/collections/all" id="cart-drawer-continue" class="text-xs uppercase tracking-[0.2em] font-bold border-b border-white pb-1 hover:text-gray-400 hover:border-gray-400 transition-colors">
            Continue Shopping
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Footer {%- endcomment -%}
    {%- if cart.item_count > 0 -%}
      <div class="border-t border-[#222] px-6 py-6 flex-shrink-0">
        <div class="flex justify-between items-center mb-6">
          <span class="text-xs uppercase tracking-widest text-gray-500">Subtotal</span>
          <span class="text-sm font-bold" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
        </div>
        <p class="text-[10px] text-gray-500 uppercase tracking-widest mb-4 text-center">Shipping & taxes calculated at checkout</p>
        <a href="/checkout" class="block w-full py-4 bg-white text-black text-xs uppercase tracking-[0.2em] font-bold hover:bg-gray-200 transition-colors text-center">
          Checkout — {{ cart.total_price | money }}
        </a>
        {% render 'trust-badges' %}
      </div>
    {%- endif -%}
  </div>
</div>

<header id="site-header" class="fixed top-0 w-full z-40 bg-black/95 backdrop-blur-sm border-b border-[#222] transition-all duration-300">
  <div class="max-w-[1600px] mx-auto px-6 h-16 md:h-20 flex items-center justify-between">

    {%- comment -%} Left: Desktop Nav {%- endcomment -%}
    {%- if section.settings.menu != blank -%}
      <nav class="hidden md:flex gap-8" aria-label="Main navigation">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"
             class="text-[10px] tracking-[0.25em] uppercase font-bold hover:text-gray-400 transition-colors {% if link.active %}text-white{% else %}text-gray-300{% endif %}">
            {{ link.title }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- comment -%} Left: Mobile Menu Button {%- endcomment -%}
    <button id="mobile-menu-open" class="md:hidden text-xs tracking-widest uppercase hover:text-gray-400 transition-colors" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    {%- comment -%} Center: Logo {%- endcomment -%}
    <div class="absolute left-1/2 -translate-x-1/2">
      <a href="{{ routes.root_url }}" class="block relative w-36 md:w-48 h-16 md:h-20 flex items-center justify-center" aria-label="{{ shop.name }} - Home">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" class="object-contain max-h-[80%] mix-blend-screen" width="400" height="160">
        {%- else -%}
          <span class="text-xl md:text-2xl font-bold tracking-tighter uppercase italic">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Right: Cart {%- endcomment -%}
    <div class="flex items-center gap-4 md:gap-6">
      <a href="{{ routes.account_url }}" class="hidden md:block text-[10px] tracking-[0.25em] uppercase font-bold hover:text-gray-400 transition-colors text-gray-300" aria-label="Account">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </a>
      <button data-cart-trigger class="text-[10px] tracking-[0.25em] uppercase font-bold hover:text-gray-400 transition-colors flex items-center gap-2 relative" aria-label="Open cart">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        {%- if cart.item_count > 0 -%}
          <span data-cart-count class="absolute -top-2 -right-2 bg-white text-black rounded-full w-4 h-4 text-[9px] font-bold flex items-center justify-center">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile Menu {%- endcomment -%}
<div id="mobile-menu" class="fixed inset-0 z-50 pointer-events-none md:hidden" aria-hidden="true">
  <div data-overlay class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300"></div>
  <div data-panel class="absolute inset-y-0 left-0 w-full max-w-sm bg-black border-r border-[#222] -translate-x-full transition-transform duration-300 flex flex-col">
    <div class="flex items-center justify-between px-6 h-16 border-b border-[#222]">
      <span class="text-xs font-bold uppercase tracking-[0.2em]">Menu</span>
      <button id="mobile-menu-close" class="text-xs uppercase tracking-widest hover:text-gray-400 transition-colors" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-col px-6 py-8 flex-1">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="text-2xl font-bold uppercase tracking-widest py-4 border-b border-[#222] hover:text-gray-400 transition-colors hover:pl-2">
            {{ link.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="px-6 py-6 border-t border-[#222]">
      <a href="{{ routes.account_url }}" class="text-xs uppercase tracking-widest text-gray-500 hover:text-white transition-colors">Account</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}

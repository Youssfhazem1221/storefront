<header class="fixed top-0 w-full z-30 bg-black border-b border-[#222]">
  <div class="max-w-[1600px] mx-auto px-6 h-20 flex items-center justify-between">
    
    {%- if section.settings.menu != blank -%}
      <nav class="hidden md:flex gap-8">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="text-xs tracking-[0.2em] uppercase font-bold hover:text-gray-400 transition-colors">
            {{ link.title }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <button 
      class="md:hidden text-xs tracking-widest uppercase"
      aria-label="Menu"
    >
      Menu
    </button>

    <div class="absolute left-1/2 -translate-x-1/2">
      <a href="{{ routes.root_url }}" class="block relative w-48 h-20 flex items-center justify-center mix-blend-screen">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" class="object-contain max-h-full">
        {%- else -%}
          <span class="text-2xl font-bold tracking-tighter uppercase italic">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="flex items-center gap-6">
      <a href="{{ routes.cart_url }}" class="text-xs tracking-[0.2em] uppercase font-bold hover:text-gray-400 transition-colors outline-none">
        Cart ({{ cart.item_count }})
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}

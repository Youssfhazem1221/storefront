<section class="border-t border-[#222] py-20 md:py-28 bg-black">
  <div class="max-w-[1600px] mx-auto px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
    <div class="max-w-md">
      <h2 class="text-2xl md:text-3xl font-bold uppercase tracking-widest text-white mb-3">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="text-xs text-gray-500 uppercase tracking-widest leading-relaxed">
        {{ section.settings.subheading | escape }}
      </p>
    </div>

    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="flex w-full md:w-auto">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          autocomplete="email"
          class="bg-transparent border border-[#222] border-r-0 text-xs uppercase tracking-widest py-4 px-6 w-full md:w-80 focus:outline-none focus:border-white transition-colors placeholder:text-gray-600"
        >
        <button type="submit" class="bg-white text-black text-xs uppercase tracking-[0.2em] font-bold px-8 py-4 hover:bg-gray-200 transition-colors whitespace-nowrap flex-shrink-0">
          {{ section.settings.button_label | escape }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Culture"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to know about new drops, exclusive offers, and behind-the-scenes content."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}

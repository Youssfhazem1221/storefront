<footer class="border-t border-[#222] bg-black mt-20">
  <div class="max-w-[1600px] mx-auto px-6 py-12 md:py-20 flex flex-col md:flex-row justify-between gap-12">
    <div class="flex flex-col gap-6 max-w-sm">
      <a href="{{ routes.root_url }}" class="block relative w-64 h-32 mix-blend-screen">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ shop.name }}" class="object-contain object-left max-h-full w-full">
        {%- else -%}
          <span class="text-3xl font-bold tracking-tighter uppercase italic">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <p class="text-xs text-gray-500 uppercase tracking-widest leading-relaxed">
        {{ section.settings.about_text | escape }}
      </p>
    </div>

    <div class="flex gap-16 md:gap-24">
      {%- for linklist in section.blocks -%}
        <div class="flex flex-col gap-4">
          <h4 class="text-xs font-bold uppercase tracking-widest mb-2 text-white">{{ linklist.settings.heading | escape }}</h4>
          {%- for link in linklist.settings.menu.links -%}
            <a href="{{ link.url }}" class="text-xs text-gray-400 uppercase tracking-[0.1em] hover:text-white transition-colors">
              {{ link.title }}
            </a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  
  <div class="border-t border-[#111]">
    <div class="max-w-[1600px] mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[10px] text-gray-600 uppercase tracking-widest">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.
      </p>
      <div class="flex gap-4">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="text-[10px] text-gray-600 uppercase tracking-widest hover:text-white">Instagram</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "A high-end brutalist aesthetic for the modern avant-garde. Designed with intention."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}

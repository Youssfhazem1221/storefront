<footer class="border-t border-[#222] bg-black">
  <div class="max-w-[1600px] mx-auto px-6 py-12 md:py-20">
    {%- comment -%} 
      GRID 6: 
      - Brand takes 4 columns (the left 66%)
      - Menus take 2 columns (the right 33%)
    {%- endcomment -%}
    <div class="grid grid-cols-1 md:grid-cols-6 gap-12">

      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="md:col-span-4 flex flex-col gap-6 max-w-sm">
        <a href="{{ routes.root_url }}" class="block w-64 h-auto mix-blend-screen" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ shop.name }}" class="object-contain object-left max-h-32" loading="lazy" width="256" height="128">
          {%- else -%}
            <span class="text-2xl font-bold tracking-tighter uppercase italic text-white">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <p class="text-xs text-gray-500 uppercase tracking-widest leading-relaxed">
          {{ section.settings.about_text | escape }}
        </p>
        <div class="flex gap-4 mt-2">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="text-gray-600 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} 
        Menu Wrapper (Occupies the 2 columns on the right)
        - md:justify-end: Pushes the group to the right wall.
        - md:gap-24: Creates that specific distance between Link 1 and Link 2.
      {%- endcomment -%}
      <div class="md:col-span-2 flex flex-col md:flex-row md:justify-end gap-10 md:gap-24">
        {%- for block in section.blocks -%}
          <div class="flex flex-col gap-4 min-w-[120px]" {{ block.shopify_attributes }}>
            <h4 class="text-xs font-bold uppercase tracking-widest mb-2 text-white">
              {{ block.settings.heading | escape }}
            </h4>
            {%- if block.settings.menu != blank -%}
              <div class="flex flex-col gap-2">
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="text-xs text-gray-400 uppercase tracking-[0.1em] hover:text-white transition-colors">
                    {{ link.title }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>

  <div class="border-t border-[#111]">
    <div class="max-w-[1600px] mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[9px] text-gray-600 uppercase tracking-widest">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
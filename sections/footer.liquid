<footer class="border-t border-[#222] bg-black">
  <div class="max-w-[1600px] mx-auto px-6 py-16 md:py-20">
    
    {%- comment -%} 
       1. INCREASED GAP-12 TO MD:GAP-64 
       This pushes the Brand column and the Menu group further apart.
    {%- endcomment -%}
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 md:gap-64">

      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="flex flex-col gap-6 max-w-sm">
         </div>

      {%- comment -%} 
        Menu Container 
        2. INCREASED MD:GAP-32 TO MD:GAP-48
        This increases the distance between the "SUPPORT" menu and other menus.
      {%- endcomment -%}
      <div class="flex flex-col md:flex-row gap-10 md:gap-48 text-left">
        {%- for block in section.blocks -%}
          <div class="flex flex-col gap-3 min-w-[120px]" {{ block.shopify_attributes }}>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.25em] mb-1 text-white">
              {{ block.settings.heading | escape }}
            </h4>
            {%- if block.settings.menu != blank -%}
              <div class="flex flex-col gap-2">
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="text-[10px] text-gray-500 uppercase tracking-widest hover:text-white transition-colors">
                    {{ link.title }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Premium streetwear for the modern culture. Designed with intention, crafted with purpose."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}

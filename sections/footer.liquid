<footer class="border-t border-[#222] bg-black">
  <div class="max-w-[1600px] mx-auto px-6 py-16 md:py-20">
    
    <div class="flex flex-col md:flex-row justify-between items-start gap-12">

      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="flex flex-col gap-6 max-w-sm">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="inline-block">
            {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: 
              class: 'h-auto w-auto max-w-[150px]',
              alt: logo_alt,
              loading: 'lazy'
            }}
          </a>
        {%- endif -%}

        {%- if section.settings.about_text != blank -%}
          <p class="text-[10px] text-gray-500 uppercase tracking-widest leading-relaxed">
            {{ section.settings.about_text }}
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} Menu Container {%- endcomment -%}
      <div class="flex flex-col md:flex-row gap-10 md:gap-24 lg:gap-48 text-left">
        {%- for block in section.blocks -%}
          <div class="flex flex-col gap-3 min-w-[120px]" {{ block.shopify_attributes }}>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.25em] mb-1 text-white">
              {{ block.settings.heading | escape }}
            </h4>
            
            {%- if block.settings.menu != blank -%}
              <nav class="flex flex-col gap-2" aria-label="{{ block.settings.heading }}">
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="text-[10px] text-gray-500 uppercase tracking-widest hover:text-white transition-colors">
                    {{ link.title }}
                  </a>
                {%- endfor -%}
              </nav>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Premium streetwear for the modern culture. Designed with intention, crafted with purpose."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}

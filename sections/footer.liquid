<footer class="border-t border-[#222] bg-black">
  <div class="max-w-[1600px] mx-auto px-6 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">

      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="md:col-span-2 flex flex-col gap-6">
        <a href="{{ routes.root_url }}" class="block w-48" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" class="object-contain object-left max-h-20 mix-blend-screen" loading="lazy" width="400" height="80">
          {%- else -%}
            <span class="text-2xl font-bold tracking-tighter uppercase italic">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <p class="text-[10px] text-gray-500 uppercase tracking-widest leading-relaxed max-w-sm">
          {{ section.settings.about_text | escape }}
        </p>
        <div class="flex gap-4 mt-2">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="text-gray-600 hover:text-white transition-colors" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" class="text-gray-600 hover:text-white transition-colors" aria-label="TikTok">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.27 8.27 0 005.58 2.17V11.7a4.83 4.83 0 01-3.77-1.6V6.69h3.77z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

    {%- comment -%} 
        Menu Container
        - md:justify-end keeps the group to the right
        - md:gap-56 creates a large distance between Quick Links and Support
      {%- endcomment -%}
      <div class="md:col-span-2 flex flex-col md:flex-row md:justify-end gap-10 md:gap-1">
        {%- for block in section.blocks -%}
          <div class="flex flex-col gap-3 min-w-[12240px]" {{ block.shopify_attributes }}>
            <h4 class="text-[10px] font-bold uppercase tracking-[0.222em] mb-1 text-white">
              {{ block.settings.heading | escape }}
            </h4>
            {%- if block.settings.menu != blank -%}
              <div class="flex flex-col gap-2">
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="text-[10px] text-gray-500 uppercase tracking-widest hover:text-white transition-colors">
                    {{ link.title }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Bottom Bar {%- endcomment -%}
  <div class="border-t border-[#111]">
    <div class="max-w-[1600px] mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[9px] text-gray-600 uppercase tracking-widest">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      <div class="flex items-center gap-3 text-gray-600">
        <span class="text-[8px] uppercase tracking-widest">Visa</span>
        <span class="text-[6px]">•</span>
        <span class="text-[8px] uppercase tracking-widest">Mastercard</span>
        <span class="text-[6px]">•</span>
        <span class="text-[8px] uppercase tracking-widest">PayPal</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Premium streetwear for the modern culture. Designed with intention, crafted with purpose."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
<section class="py-16 md:py-24 border-t border-[#222]">
  <div class="max-w-[1600px] mx-auto px-6">
    <h2 class="text-xl md:text-2xl font-bold uppercase tracking-widest text-white mb-12 text-center">
      {{ section.settings.heading | escape }}
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-10 md:gap-x-6 md:gap-y-16">
      {%- assign related = product.collections.first.products -%}
      {%- assign count = 0 -%}
      {%- for related_product in related limit: 8 -%}
        {%- if related_product.id != product.id and count < 4 -%}
          {% render 'product-card', product: related_product, index: forloop.index %}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}

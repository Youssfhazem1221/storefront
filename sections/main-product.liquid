<div class="max-w-[1600px] mx-auto min-h-screen">
  <div class="flex flex-col lg:flex-row min-h-[calc(100vh-80px)]">

    {%- comment -%} Left: Image Gallery {%- endcomment -%}
    <div class="w-full lg:w-[60%] border-b lg:border-b-0 lg:border-r border-[#222] flex flex-col">
      {%- for image in product.images -%}
        <div class="relative aspect-[3/4] w-full border-b border-[#222] last:border-b-0 bg-[#0a0a0a] overflow-hidden">
          <img
            src="{{ image | image_url: width: 1200 }}"
            srcset="{{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 900 }} 900w,
                    {{ image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 1024px) 100vw, 60vw"
            alt="{{ product.title | escape }} - View {{ forloop.index }}"
            class="object-cover object-top w-full h-full opacity-90 hover:opacity-100 transition-opacity duration-500"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {%- if forloop.first %} fetchpriority="high"{% endif %}
            width="1200"
            height="1600"
          >
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Right: Product Details {%- endcomment -%}
    <div class="w-full lg:w-[40%] px-6 py-10 lg:px-12 lg:py-16 lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-80px)] lg:overflow-y-auto">

      {%- comment -%} Breadcrumb {%- endcomment -%}
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-gray-500">
          <li><a href="{{ routes.root_url }}" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="text-gray-600">/</span></li>
          {%- if product.collections.size > 0 -%}
            <li><a href="{{ product.collections.first.url }}" class="hover:text-white transition-colors">{{ product.collections.first.title }}</a></li>
            <li><span class="text-gray-600">/</span></li>
          {%- endif -%}
          <li class="text-gray-400">{{ product.title | truncate: 30 }}</li>
        </ol>
      </nav>

      {%- comment -%} Title & Price {%- endcomment -%}
      <div class="mb-8 border-b border-[#222] pb-8">
        <h1 class="text-3xl md:text-4xl font-bold uppercase tracking-widest leading-tight mb-3">
          {{ product.title }}
        </h1>
        <div class="flex items-center gap-3 mt-4">
          {%- if product.compare_at_price > product.price -%}
            <span id="product-compare-price" class="text-sm text-gray-500 line-through">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
          <span id="product-price" class="text-xl font-bold">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            <span class="bg-white text-black text-[10px] uppercase tracking-widest font-bold px-2 py-1">Save {{ savings }}%</span>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Product Form {%- endcomment -%}
      <div class="mb-8 border-b border-[#222] pb-8">
        {%- form 'product', product, id: 'product-form' -%}
          <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- if product.variants.size > 1 -%}
            <div class="mb-6">
              <label class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-4">
                {{ product.options.first }} — <span class="text-gray-400 font-normal" id="selected-option">{{ product.selected_or_first_available_variant.title }}</span>
              </label>
              <select id="variant-select" name="id" class="w-full bg-black border border-[#222] text-xs uppercase tracking-widest py-4 px-4 focus:outline-none focus:border-white transition-colors appearance-none cursor-pointer">
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money }}"
                    data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-available="{{ variant.available }}"
                    {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} — Sold Out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="mb-6">
            <label class="block text-[10px] font-bold uppercase tracking-[0.25em] mb-4">Quantity</label>
            <div class="flex items-center border border-[#222] w-fit">
              <button type="button" class="px-4 py-3 text-sm hover:text-gray-400 transition-colors" onclick="this.nextElementSibling.stepDown(); this.nextElementSibling.dispatchEvent(new Event('change'))">−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" class="w-12 text-center bg-transparent text-sm py-3 border-x border-[#222] focus:outline-none font-mono">
              <button type="button" class="px-4 py-3 text-sm hover:text-gray-400 transition-colors" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.dispatchEvent(new Event('change'))">+</button>
            </div>
          </div>

          {%- comment -%} Add to Cart Button {%- endcomment -%}
          <button type="submit"
                  id="add-to-cart-btn"
                  name="add"
                  class="w-full py-4 bg-white text-black text-[10px] uppercase tracking-[0.25em] font-bold hover:bg-gray-100 transition-all disabled:bg-[#222] disabled:text-gray-600 disabled:cursor-not-allowed"
                  {% unless product.available %}disabled{% endunless %}>
            <span id="add-to-cart-text">
              {%- if product.available -%}
                Add to Cart — {{ product.price | money }}
              {%- else -%}
                Sold Out
              {%- endif -%}
            </span>
          </button>
        {%- endform -%}
      </div>

      {%- comment -%} Trust Badges {%- endcomment -%}
      {% render 'trust-badges' %}

      {%- comment -%} Description & Details {%- endcomment -%}
      <div class="space-y-6 mb-8">
        {%- if product.description != blank -%}
          <details class="group border-b border-[#222]" open>
            <summary class="flex items-center justify-between py-4 cursor-pointer text-[10px] font-bold uppercase tracking-[0.25em] text-white">
              Description
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="text-sm text-gray-400 leading-relaxed pb-6 max-w-lg">
              {{ product.description }}
            </div>
          </details>
        {%- endif -%}

        <details class="group border-b border-[#222]">
          <summary class="flex items-center justify-between py-4 cursor-pointer text-[10px] font-bold uppercase tracking-[0.25em] text-white">
            Shipping & Returns
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div class="text-sm text-gray-400 leading-relaxed pb-6 space-y-3">
            <p>Free delivery on orders over 1000 EGP. Standard shipping 3–5 business days.</p>
            <p>Returns accepted within 14 days. Items must be unworn with tags attached.</p>
          </div>
        </details>
      </div>

    </div>
  </div>
</div>

{%- comment -%} Sticky Mobile Add to Cart Bar {%- endcomment -%}
<div class="fixed bottom-0 left-0 right-0 z-40 bg-black/95 backdrop-blur-sm border-t border-[#222] p-4 lg:hidden">
  <div class="flex items-center justify-between gap-4 max-w-[600px] mx-auto">
    <div class="flex-1 min-w-0">
      <p class="text-xs font-bold uppercase tracking-widest truncate">{{ product.title }}</p>
      <p class="text-sm mt-0.5">{{ product.price | money }}</p>
    </div>
    <form method="post" action="/cart/add">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="bg-white text-black text-[10px] uppercase tracking-[0.25em] font-bold px-6 py-3 hover:bg-gray-100 transition-colors whitespace-nowrap" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
      </button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}

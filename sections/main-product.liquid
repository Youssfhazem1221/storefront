<div class="max-w-[1600px] mx-auto min-h-screen">
  <div class="flex flex-col lg:flex-row min-h-[calc(100vh-80px)]">
    
    {% comment %} Left: Image Gallery {% endcomment %}
    <div class="w-full lg:w-[60%] border-b lg:border-b-0 lg:border-r border-[#222] flex flex-col">
      {%- for image in product.images -%}
        <div class="relative aspect-[3/4] w-full border-b border-[#222] last:border-b-0 bg-[#0a0a0a]">
          <img 
            src="{{ image | image_url: width: 1600 }}" 
            alt="{{ product.title | escape }} - View {{ forloop.index }}" 
            class="object-cover object-top w-full h-full opacity-90 hover:opacity-100 transition-opacity"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        </div>
      {%- endfor -%}
    </div>

    {% comment %} Right: Product Details {% endcomment %}
    <div class="w-full lg:w-[40%] px-6 py-12 lg:px-12 lg:py-16 sticky top-20 self-start">
      
      <div class="mb-12 border-b border-[#222] pb-8">
        <p class="text-xs uppercase tracking-widest text-gray-500 mb-4">
          {{ product.collections.first.title }}
        </p>
        <h1 class="text-4xl md:text-5xl font-bold uppercase tracking-widest leading-tight mb-2">
          {{ product.title }}
        </h1>
        <p class="text-xl">{{ product.price | money }}</p>
      </div>

      <div class="mb-12 border-b border-[#222] pb-12">
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          {%- if product.variants.size > 1 -%}
            <div class="mb-8">
              <label class="block text-xs font-bold uppercase tracking-widest mb-4">Size / Variant</label>
              <select name="id" class="w-full bg-transparent border border-[#222] text-xs uppercase tracking-widest py-4 px-4 focus:outline-none">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          <button type="submit" 
                  name="add"
                  class="w-full px-8 py-4 bg-white text-black text-xs uppercase tracking-[0.2em] font-bold hover:bg-gray-200 transition-all disabled:bg-gray-500 disabled:cursor-not-allowed"
                  {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        {%- endform -%}
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-4 text-white">Description</h3>
          <div class="text-sm text-gray-400 leading-relaxed max-w-lg">
            {{ product.description }}
          </div>
        </div>

        {%- if product.metafields.custom.details != blank -%}
          <div>
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-4 text-white">Details</h3>
            <ul class="text-sm text-gray-400 leading-relaxed list-disc pl-4 space-y-1">
              {%- for detail in product.metafields.custom.details.value -%}
                <li>{{ detail }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        
        <div class="pt-4 flex justify-between text-xs text-gray-500 uppercase tracking-widest border-t border-[#222] mt-8">
          <span>Shipping Info</span>
          <span>Returns</span>
        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}

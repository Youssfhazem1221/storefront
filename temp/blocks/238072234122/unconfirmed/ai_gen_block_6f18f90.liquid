{% doc %}
  @prompt
    an archive page with previous collections taking influence from erd website 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-archive-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-archive-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-archive-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-archive-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-archive-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.grid_gap }}px;
  }

  .ai-archive-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.item_background }};
    transition: transform 0.3s ease;
  }

  .ai-archive-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-archive-item-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-archive-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-archive-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .ai-archive-item-{{ ai_gen_id }}:hover .ai-archive-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-archive-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-archive-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-archive-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-archive-item-{{ ai_gen_id }}:hover .ai-archive-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-archive-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-archive-season-{{ ai_gen_id }} {
    font-size: {{ block.settings.season_size }}px;
    color: {{ block.settings.season_color }};
    margin: 0 0 8px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ai-archive-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.collection_title_color }};
    margin: 0 0 8px;
    font-weight: {{ block.settings.collection_title_weight }};
    letter-spacing: 0.5px;
  }

  .ai-archive-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-archive-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-archive-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-archive-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-archive-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-archive-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.6);
    }
  }
{% endstyle %}

<archive-collections-{{ ai_gen_id }} class="ai-archive-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <div class="ai-archive-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-archive-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-archive-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-archive-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign season_key = 'season_' | append: i
        assign collection = block.settings[collection_key]
        assign season = block.settings[season_key]
      %}

      {% if collection != blank %}
        <div class="ai-archive-item-{{ ai_gen_id }}">
          <a href="{{ collection.url }}" class="ai-archive-item-link-{{ ai_gen_id }}">
            <div class="ai-archive-image-wrapper-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: block.settings.image_ratio }}"
                  class="ai-archive-image-{{ ai_gen_id }}"
                >
              {% elsif collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.products.first.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | divided_by: block.settings.image_ratio }}"
                  class="ai-archive-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-archive-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-archive-overlay-{{ ai_gen_id }}"></div>
            </div>
            <div class="ai-archive-content-{{ ai_gen_id }}">
              {% if season != blank %}
                <p class="ai-archive-season-{{ ai_gen_id }}">{{ season }}</p>
              {% endif %}
              <h3 class="ai-archive-collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% if block.settings.show_product_count %}
                <p class="ai-archive-meta-{{ ai_gen_id }}">{{ collection.products_count }} {% if collection.products_count == 1 %}item{% else %}items{% endif %}</p>
              {% endif %}
            </div>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</archive-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class ArchiveCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-archive-item-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.items.forEach((item) => {
          const link = item.querySelector('.ai-archive-item-link-{{ ai_gen_id }}');
          if (link) {
            link.setAttribute('aria-label', 'View collection');
          }
        });
      }
    }

    customElements.define('archive-collections-{{ ai_gen_id }}', ArchiveCollections{{ ai_gen_id }});
  })();
</script>

